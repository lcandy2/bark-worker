{
    "name": "bark-worker",
    "main": "main.js",
    "compatibility_date": "2026-03-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "observability": {
        "enabled": true,
        "issues": {
            "enabled": true
        },
        "logs": {
            "enabled": true,
            "invocation_logs": false
        },
        "traces": {
            "enabled": false
        }
    },
    "d1_databases": [
        {
            "binding": "database",
            "database_name": "bark-worker-db",
            "database_id": "8d5d9f97-93d8-4d7a-a059-6bbee62a2217"
        }
    ],
    "keep_vars": true,
    "vars": {
        "ALLOW_NEW_DEVICE": "true",
        "ALLOW_QUERY_NUMS": "true",
        "ROOT_PATH": "/",
        // "BASIC_AUTH": ""
    }
}
